## Run beads
.PHONY: issue/prime
issue/prime:
	@tools/bin/bd prime

## Show issues ready to work on
.PHONY: issue/ready
issue/ready:
	@tools/bin/bd ready

## Claim issue
.PHONY: issue/claim
issue/claim:
	@tools/bin/bd update $(ISSUE_ID) --claim

## Set issue status
.PHONY: issue/set-status
issue/set-status:
	@tools/bin/bd update $(ISSUE_ID) --status "$(STATUS)" --append-notes "$(REASON)"

## Review issue details
.PHONY: issue/show
issue/show:
	@tools/bin/bd show $(ISSUE_ID)

## Create issues
.PHONY: issue/create
issue/create:
	@tools/bin/bd create "$(TITLE)" --description "$$(printf '%b' "$(DESCRIPTION)")" --type=$(TYPE)

## Create child issue under a parent
.PHONY: issue/create-child
issue/create-child:
	@tools/bin/bd create "$(TITLE)" --description "$$(printf '%b' "$(DESCRIPTION)")" --type=$(TYPE) --parent $(PARENT)

## Link issues
.PHONY: issue/link
issue/link:
	@tools/bin/bd dep add $(ISSUE_ID) $(DEPENS_ON_ID)

## Unlink issues
.PHONY: issue/unlink
issue/unlink:
	@tools/bin/bd dep remove $(ISSUE_ID) $(DEPENS_ON_ID)

## Close issues
.PHONY: issue/close
issue/close:
	@tools/bin/bd close $(ISSUES) --reason "$(REASON)"

## Search issues by keyword
.PHONY: issue/search
issue/search:
	@tools/bin/bd search "${QUERY}"
